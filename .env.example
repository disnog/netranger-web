# netranger-web environment variables
# Copy this file to .env and fill in real values (never commit .env).

# --- Required ---
OAUTH2_CLIENT_ID=your-discord-oauth2-client-id
OAUTH2_CLIENT_SECRET=your-discord-oauth2-client-secret

# --- MariaDB (netranger-db) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=netranger
DB_PASS=changeme
DB_NAME=netranger

# --- Discord bot (for guild membership checks) ---
BOT_TOKEN=your-discord-bot-token-here
GUILD_ID=your-discord-guild-id-here

# --- Session signing ---
# Defaults to OAUTH2_CLIENT_SECRET if not set; set explicitly in production.
SECRET_KEY=a-long-random-string-for-signing-cookies

# --- OAuth2 callback (optional — inferred from request host if not set) ---
# OAUTH2_REDIRECT_URI=https://yoursite.example.com/login_callback

# --- Runtime ---
# NRWEB_ENVIRONMENT=prod   # or: dev, staging
# DEBUG=false
